# 本机地址：http://127.0.0.1:4318
# 默认端口来自 config/workbench.json；需要覆盖时取消下一行注释。
# PORT=4318

# 推荐在页面“接入设置”里配置 AI（保存到 data/model.json，优先于这里）。
# 只有页面上从未保存过设置时，才读取以下配置。
# 在线服务的选定会话内容会发送至该服务商。
MODEL_ENABLED=false
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# DeepSeek 示例：BASE_URL=https://api.deepseek.com，NAME=deepseek-flash
# 本地 Ollama 示例：BASE_URL=http://127.0.0.1:11434/v1，NAME=已下载的本地模型名
# 本地 Ollama 不需要 MODEL_API_KEY。不要将云端模型当成本地模型。
